{
  "name": "merlin-ia",
  "version": "0.1.0",
  "description": "Assistente local com RAG para Linux",
  "author": {
    "name": "N1ghthill",
    "email": "n1ghthill@users.noreply.github.com"
  },
  "homepage": "https://github.com/n1ghthill/merlin-ia",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:deb": "electron-builder --linux deb",
    "dist:rpm": "electron-builder --linux rpm",
    "dist:win": "electron-builder --windows",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "io.github.n1ghthill.merlin-ia",
    "productName": "Merlin IA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "icons/**/*"
    ],
    "extraResources": [
      {
        "from": "../electron-app",
        "to": "electron-app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../merlin_api.py",
        "to": "merlin_api.py"
      },
      {
        "from": "../merlin_cli.py",
        "to": "merlin_cli.py"
      },
      {
        "from": "../rag_indexer.py",
        "to": "rag_indexer.py"
      },
      {
        "from": "../merlin",
        "to": "merlin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../executor",
        "to": "executor",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../scrolls",
        "to": "scrolls",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "../requirements-api.txt",
        "to": "requirements-api.txt"
      },
      {
        "from": "../scripts/merlin-wrapper.sh",
        "to": "scripts/merlin-wrapper.sh"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "icons/merlin.png",
      "executableName": "merlin-ia",
      "maintainer": "N1ghthill <n1ghthill@users.noreply.github.com>",
      "desktop": {
        "Name": "Merlin IA",
        "Comment": "Assistente local com RAG",
        "Categories": "Utility;AI;"
      }
    },
    "deb": {
      "depends": [
        "python3",
        "python3-pip",
        "python3-venv"
      ],
      "afterInstall": "../scripts/postinstall.sh"
    },
    "rpm": {
      "depends": [
        "python3",
        "python3-pip"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "icons/merlin.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icons/merlin.icns"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
