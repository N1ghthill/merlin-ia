# Merlin core
MODEL_NAME=qwen2.5:7b
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage
# MERLIN_STORAGE_MODE=user
# MERLIN_DATA_DIR=~/.local/share/merlin-ia
# MERLIN_STATE_DIR=~/.local/state/merlin-ia
# MERLIN_SCROLLS_DIR=~/.local/share/merlin-ia/scrolls
# MERLIN_CHROMA_DIR=~/.local/share/merlin-ia/chroma
# MERLIN_HISTORY_PATH=~/.local/state/merlin-ia/history.jsonl
# MERLIN_AUTO_INDEX_SCROLLS=1

# Linux executor gate (disabled by default)
# MERLIN_ENABLE_EXECUTOR=1

# Audit log path for confirmed write actions
# MERLIN_AUDIT_LOG=/var/log/merlin/audit.log

# Linux CLI knobs
# LINUX_READ_ONLY=0
# LINUX_PENDING_TTL=300
# LINUX_AUTO_INTENTS=0
# LINUX_LOG_ACTIONS=1
# LINUX_RAG_INDEX=1
# LINUX_RAG_MAX_CHARS=2000
# LINUX_IMPACT_CMD_CHARS=300
