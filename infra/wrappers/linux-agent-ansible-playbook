#!/usr/bin/env bash
set -euo pipefail

PATH="/usr/sbin:/usr/bin:/sbin:/bin"

if [ "$#" -lt 1 ]; then
  echo "usage: linux-agent-ansible-playbook <playbook> [args...]" >&2
  exit 64
fi

# Ensure Ansible temp dir is writable even when ProtectHome=yes
tmp_dir="/var/tmp/ansible"
mkdir -p "$tmp_dir"
chmod 700 "$tmp_dir"
export ANSIBLE_LOCAL_TEMP="$tmp_dir"
export ANSIBLE_REMOTE_TMP="$tmp_dir"

# Keep ansible home writable even with ProtectHome=yes
ansible_home="/var/tmp/ansible-home"
mkdir -p "$ansible_home"
chmod 700 "$ansible_home"
export HOME="$ansible_home"

ansible_bin="$(command -v ansible-playbook || true)"
if [ -z "$ansible_bin" ]; then
  echo "ansible-playbook not found" >&2
  exit 127
fi

exec "$ansible_bin" "$@"
